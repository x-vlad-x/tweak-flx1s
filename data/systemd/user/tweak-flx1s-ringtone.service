[Unit]
Description=Independent incoming-call ringtone volume
After=graphical-session.target

[Service]
ExecStart=/usr/bin/tweak-flx1s --monitor ringtone
ExecStopPost=/usr/bin/tweak-flx1s --restore-ringtone-volume
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
UMask=0077

[Install]
WantedBy=default.target
